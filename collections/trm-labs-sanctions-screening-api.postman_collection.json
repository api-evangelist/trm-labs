          "request": {
            "name": "Submit one or more addresses to be screened",
            "description": {
              "content": "Returns whether each address provided has sanctions exposure. By default the API is limited to 1 req/sec and a maximum of 100 req/day. API-key holders receive higher limits.",
              "type": "text/plain"
            },
